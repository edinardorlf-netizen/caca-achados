# Copie este arquivo com o nome config.env e preencha.
# Endereço do serviço (não mude)
URL=https://airbtbqorhrrzqhucmzu.supabase.co/functions/v1/achados-zap
# Chave do robô: gere no app, em Ajustes > Robô do WhatsApp > Gerar chave do robô
CHAVE=
# Links dos grupos ou canal do WhatsApp onde o robô posta (separe com vírgula)
DESTINOS=
# Nome base dos grupos novos que o robô cria quando um grupo enche (ex.: Achados da Ana)
NOME_GRUPO=
# Quantas pessoas um grupo pode ter antes de o robô criar o próximo, e o máximo de grupos
LIMITE_GRUPO=950
MAX_GRUPOS=10
# Pausa (em segundos) entre um grupo e outro na mesma rodada
PAUSA_GRUPOS_MIN=15
PAUSA_GRUPOS_MAX=40
# (Opcional) Seu número com DDD, só números, para entrar como administrador nos grupos novos
ADMIN_NUMERO=
